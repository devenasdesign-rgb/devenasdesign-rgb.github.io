---
import type { Locale } from '../lib/i18n';

const { lang } = Astro.props as { lang: Locale };
const ru = lang === 'ru';
---

<div class="ck" data-ck role="dialog" aria-live="polite" aria-label={ru ? 'Cookies и аналитика' : 'Cookies and analytics'} hidden>
  <p>
    {ru
      ? 'Сайт использует Яндекс Метрику (cookies), чтобы я понимала, что работает, а что нет. Ваши ответы в брифе она не видит.'
      : 'This site uses Yandex Metrica (cookies) so I can see what works and what does not. Yandex processes this data, including in Russia. It does not see your brief answers.'}
    {' '}
    <a href={`/${lang}/privacy/#cookies`}>{ru ? 'Подробнее' : 'Details'}</a>
  </p>
  <div class="ck__actions">
    <button type="button" class="btn btn-primary" data-ck-accept>{ru ? 'Принять' : 'Accept'}</button>
    <button type="button" class="btn btn-secondary" data-ck-decline>{ru ? 'Отказаться' : 'Decline'}</button>
  </div>
</div>

<style>
  .ck {
    position: fixed;
    left: 16px;
    bottom: calc(16px + env(safe-area-inset-bottom, 0px));
    z-index: 95;
    width: min(440px, calc(100vw - 32px));
    padding: 16px;
    background: var(--ink);
    color: var(--dark);
    box-shadow: 6px 6px 0 var(--lime);
  }
  .ck[hidden] {
    display: none;
  }
  .ck p {
    font-size: 13px;
    line-height: 1.5;
    margin: 0 0 12px;
  }
  .ck a {
    border-bottom: 1px solid currentColor;
    white-space: nowrap;
  }
  .ck__actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .ck__actions :global(.btn) {
    padding: 10px 16px;
    font-size: 11px;
  }
  .ck__actions :global(.btn-secondary) {
    color: var(--dark);
    border-color: rgba(10, 10, 10, 0.5);
  }
  .ck__actions :global(.btn-secondary:hover) {
    background: var(--dark);
    color: var(--ink);
  }
  @media (min-width: 768px) {
    .ck {
      left: 24px;
      bottom: 24px;
    }
  }
</style>

<script>
  import { seo } from '../data/seo';

  const KEY = 'dv-consent';
  const w = window as any;
  const banner = document.querySelector<HTMLElement>('[data-ck]');
  const readChoice = () => { try { return localStorage.getItem(KEY); } catch { return null; } };
  const writeChoice = (value: string) => { try { localStorage.setItem(KEY, value); } catch { /* private mode */ } };
  let loaded = false;

  const loadMetrica = () => {
    if (loaded || !seo.metrikaId) return;
    loaded = true;
    (function (m: any, e: Document, t: string, r: string, i: string) {
      m[i] = m[i] || function () { (m[i].a = m[i].a || []).push(arguments); };
      m[i].l = Date.now();
      const k = e.createElement(t) as HTMLScriptElement;
      k.async = true; k.src = r;
      e.head.appendChild(k);
    })(w, document, 'script', 'https://mc.yandex.ru/metrika/tag.js', 'ym');
    w.ym(seo.metrikaId, 'init', { clickmap: true, trackLinks: true, accurateTrackBounce: true, webvisor: true });
  };

  const goal = (name: string) => { if (loaded && w.ym) w.ym(seo.metrikaId, 'reachGoal', name); };

  const setBanner = (open: boolean) => {
    if (!banner) return;
    banner.hidden = !open;
    document.documentElement.toggleAttribute('data-ck-open', open);
  };

  const choice = readChoice();
  if (choice === 'yes') loadMetrica();
  else if (choice === null) setBanner(true);

  document.querySelector('[data-ck-accept]')?.addEventListener('click', () => { writeChoice('yes'); setBanner(false); loadMetrica(); });
  document.querySelector('[data-ck-decline]')?.addEventListener('click', () => { writeChoice('no'); setBanner(false); });
  document.querySelectorAll('[data-cookie-settings]').forEach((el) => el.addEventListener('click', () => setBanner(true)));

  // Goals for the funnel (create them in Metrica → Goals → JavaScript event, using these identifiers):
  //   brief_open, brief_step2, brief_step3, brief_sent, brief_fallback,
  //   telegram_click, whatsapp_click, floating_open, builder_used, builder_cta, case_open
  window.addEventListener('dv:goal', (event) => goal((event as CustomEvent<string>).detail));

  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement | null;
    if (!target) return;
    if (target.closest('[data-open-brief], [data-open-task-brief]')) goal('brief_open');
    if (target.closest('a[href*="t.me/"]')) goal('telegram_click');
    if (target.closest('a[href*="wa.me/"]')) goal('whatsapp_click');
    if (target.closest('[data-fc-toggle]')) goal('floating_open');
    if (target.closest('[data-yoursite-rebuild]')) goal('builder_used');
    if (target.closest('[data-yoursite-cta]')) goal('builder_cta');
    if (target.closest('a[href*="/cases/"]')) goal('case_open');
  });
  let builderTyped = false;
  document.addEventListener('input', (event) => {
    if (!builderTyped && (event.target as HTMLElement | null)?.closest('[data-yoursite-input]')) { builderTyped = true; goal('builder_used'); }
  });
</script>
