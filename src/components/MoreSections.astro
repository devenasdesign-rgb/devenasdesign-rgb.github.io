---
import type { Locale } from '../lib/i18n';
import { contacts } from '../data/proof';

const { lang } = Astro.props as { lang: Locale };
const ru = lang === 'ru';
const content = ru
  ? {
      faqLabel: '[04] FAQ', faqMeta: 'КОРОТКО И ПО ДЕЛУ', faqTitle: 'Вопросы, которые\nзадают чаще всего',
      faq: [
        ['Сколько стоит сайт?', 'Одностраничный сайт — от 55 000 ₽, многостраничный — от 80 000 ₽. Точную стоимость считаю после короткого брифа: она зависит от структуры, контента и задач.'],
        ['Сколько длится работа?', 'В среднем 14–22 рабочих дня. Срок фиксируем до старта — так у вас есть понятный план и дата запуска.'],
        ['Вы работаете только на Tilda?', 'Нет. Выбираю инструмент под задачу: Tilda — когда важна скорость и самостоятельное редактирование, код — когда нужен особый интерфейс или сложная логика.'],
        ['Что нужно подготовить с моей стороны?', 'Достаточно рассказать о бизнесе, целях и клиентах. Структуру, вопросы к текстам и список материалов я помогу собрать по ходу работы.'],
        ['Можно начать, если пока нет фирменного стиля?', 'Да. На этапе мудборда определим визуальное направление, а при необходимости начнём с логотипа и базовых носителей.'],
      ],
      contactLabel: '[05] КОНТАКТ', contactMeta: 'ОТВЕЧАЮ В БУДНИ 08:00–19:00', contactTitle: 'Расскажите\nо своём\nпроекте',
      contactText: 'Короткий бриф займёт пару минут. Изучу задачу и пришлю расчёт в течение дня.',
      direct: 'ИЛИ НАПИШИТЕ НАПРЯМУЮ →', briefStep: '01 / 03 · О ПРОЕКТЕ', service: 'ЧТО НУЖНО СДЕЛАТЬ? *', serviceHint: 'Выберите формат', services: ['Одностраничный сайт', 'Многостраничный сайт', 'Интернет-магазин', 'Дизайн-макет'], niche: 'СФЕРА БИЗНЕСА *', nicheHint: 'Выберите сферу', niches: ['Кафе и рестораны', 'Красота и здоровье', 'Магазин', 'Эксперт или специалист'], business: 'НАЗВАНИЕ БИЗНЕСА', businessHint: 'Например, «Кофейня на углу»', openBrief: 'ПРОДОЛЖИТЬ БРИФ · 2 МИН →',
      footer: 'САЙТЫ, КОТОРЫЕ РАБОТАЮТ НА БИЗНЕС', top: 'НАВЕРХ ↑'
    }
  : {
      faqLabel: '[04] FAQ', faqMeta: 'THE SHORT ANSWERS', faqTitle: 'Questions\nI hear most often',
      faq: [
        ['How much does a website cost?', 'A one-page website starts at $900 and a multi-page website at $1,400. I send an exact quote after a short brief, based on scope and goals.'],
        ['How long does it take?', 'Most projects take 14–22 working days. We agree on the timing before the start, so you have a clear plan and launch date.'],
        ['Do you only work in Tilda?', 'No. I choose the right tool for the task: Tilda for speed and easy editing, code for a custom interface or complex functionality.'],
        ['What do I need to prepare?', 'Tell me about your business, goals and customers. I will help shape the structure, questions for the copy and a materials checklist.'],
        ['Can we start without a brand identity?', 'Yes. We can define the visual direction at the moodboard stage, and start with a logo and essentials if needed.'],
      ],
      contactLabel: '[05] CONTACT', contactMeta: 'WEEKDAYS 08:00–19:00', contactTitle: 'Tell me\nabout your\nproject',
      contactText: 'The short brief takes a couple of minutes. I will review the task and send a quote within a day.',
      direct: 'OR MESSAGE ME DIRECTLY →', briefStep: '01 / 03 · ABOUT THE PROJECT', service: 'WHAT DO YOU NEED? *', serviceHint: 'Select a format', services: ['One-page website', 'Multi-page website', 'Online store', 'Website design'], niche: 'BUSINESS TYPE *', nicheHint: 'Select a field', niches: ['Cafes & restaurants', 'Beauty & health', 'Shop', 'Expert or specialist'], business: 'BUSINESS NAME', businessHint: 'E.g. “Corner Coffee Co.”', openBrief: 'CONTINUE THE BRIEF · 2 MIN →',
      footer: 'WEBSITES THAT WORK FOR BUSINESS', top: 'BACK TO TOP ↑'
    };
const channels: [string, string, string][] = [
  ['TELEGRAM', '@devenas', contacts.telegram],
  [ru ? 'ВКОНТАКТЕ' : 'VK', 'devenas.design', contacts.vk],
  [ru ? 'INSTAGRAM*' : 'INSTAGRAM', 'devenas.design', contacts.instagram],
  ['BEHANCE', '3649e2cc', 'https://behance.net/3649e2cc'],
  ['DPROFILE', 'devenas', 'https://dprofile.ru/devenas'],
];
const socials: [string, string][] = [
  ['TG', contacts.telegram],
  ['VK', contacts.vk],
  [ru ? 'IG*' : 'IG', contacts.instagram],
  ['BE', 'https://behance.net/3649e2cc'],
  ['DP', 'https://dprofile.ru/devenas'],
];
---

<section class="faq" id="faq">
  <div class="section-cap"><span class="mono">{content.faqLabel}</span><span class="mono">{content.faqMeta}</span></div>
  <div class="faq__layout">
    <div class="faq__side">
      <h2>{content.faqTitle.split('\n').map((line, i, arr) => i === arr.length - 1 ? <span class="marker-blue">{line}</span> : <>{line}<br /></>)}</h2>
      <p class="faq__hint">{ru ? 'Нажмите на вопрос, чтобы раскрыть ответ.' : 'Select a question to reveal the answer.'}</p>
      <aside class="faq__card">
        <img src="/assets/avatar-480.webp" alt="" width="64" height="64" loading="lazy" />
        <div><strong>{ru ? 'Не нашли ответ?' : 'Didn’t find an answer?'}</strong><span class="mono">{ru ? 'СПРОСИТЕ МЕНЯ НАПРЯМУЮ' : 'ASK ME DIRECTLY'}</span></div>
        <a class="faq__card-btn mono" href={contacts.telegram} target="_blank" rel="noopener noreferrer"><span>{ru ? 'НАПИСАТЬ В TELEGRAM' : 'MESSAGE ON TELEGRAM'}</span><span aria-hidden="true">↗</span></a>
      </aside>
    </div>
    <div class="faq__list" data-faq>
      {content.faq.map(([question, answer], index) => <button class="faq__item" type="button" aria-expanded={index === 0 ? 'true' : 'false'}><span class="mono faq__number">({String(index + 1).padStart(2, '0')})</span><span class="faq__question">{question}</span><span class="mono faq__sign" aria-hidden="true">{index === 0 ? '[−]' : '[+]'}</span><span class="faq__answer">{answer}</span></button>)}
    </div>
  </div>
</section>

<section class="contact" id="contact">
  <div class="section-cap"><span class="mono">{content.contactLabel}</span><span class="mono">{content.contactMeta}</span></div>
  <div class="contact__grid">
    <div class="contact__copy">
      <h2>{content.contactTitle.split('\n').map((line, i) => i === 2 ? <><span class="marker-lime">{line}</span><br /></> : <>{line}<br /></>)}</h2>
      <p>{content.contactText}</p>
      <span class="mono contact__direct">{content.direct}</span>
      <ul class="contact__links">
        {channels.map(([name, handle, href]) => <li><a href={href} target="_blank" rel="noopener noreferrer"><b>{name}</b><span>{handle}</span><i aria-hidden="true">↗</i></a></li>)}
      </ul>
      {ru && <p class="contact__meta mono">*МЕТА — ОРГАНИЗАЦИЯ, ЗАПРЕЩЁННАЯ В РФ</p>}
      <p class="contact__expectation">{ru ? 'После сообщения уточню задачу, предложу подходящий формат и расчёт. Если пока нет технического задания — помогу разобраться.' : 'After your message, I’ll clarify the task and suggest a format and quote. No detailed specification yet? I’ll help you work it out.'}</p>
    </div>
    <div class="contact__card">
      <div class="contact__tabs mono" aria-hidden="true"><span class="is-active">{ru ? '01 О ПРОЕКТЕ' : '01 PROJECT'}</span><span>{ru ? '02 ДЕТАЛИ' : '02 DETAILS'}</span><span>{ru ? '03 КОНТАКТЫ' : '03 CONTACT'}</span></div>
      <div class="contact__form" data-brief-prefill>
        <h3>{ru ? 'Расскажите о проекте' : 'Tell me about your project'}</h3>
        <label class="mono">{content.service}<select name="service"><option value="">{content.serviceHint}</option>{content.services.map((service) => <option>{service}</option>)}<option>{ru ? 'Другое' : 'Other'}</option></select></label>
        <label class="mono">{content.niche}<select name="niche"><option value="">{content.nicheHint}</option>{content.niches.map((niche) => <option>{niche}</option>)}<option>{ru ? 'Строительство и услуги' : 'Construction & services'}</option><option>{ru ? 'Другое' : 'Other'}</option></select></label>
        <label class="mono">{content.business}<input name="business" maxlength="120" autocomplete="organization" placeholder={content.businessHint} /></label>
        <div class="contact__foot"><span class="mono contact__step">{ru ? 'ШАГ 1/3 · ~2 МИН' : 'STEP 1/3 · ~2 MIN'}</span><button class="btn btn-primary" type="button" data-open-brief>{ru ? 'ДАЛЕЕ →' : 'NEXT →'}</button></div>
        <p class="contact__note">{ru ? 'Без обязательств. В конце брифа — отправка сообщения в Telegram.' : 'No commitment. At the end of the brief, send your message via Telegram.'}</p>
      </div>
    </div>
  </div>
</section>

<footer class="footer">
  <div class="footer__top mono">
    <nav aria-label={ru ? 'Меню в подвале' : 'Footer menu'}><a href="#work">{ru ? '[01] РАБОТЫ' : '[01] WORK'}</a><a href="#services">{ru ? '[02] УСЛУГИ' : '[02] SERVICES'}</a><a href="#process">{ru ? '[03] ПРОЦЕСС' : '[03] PROCESS'}</a><a href="#faq">[04] FAQ</a><a href="#contact">{ru ? '[05] КОНТАКТ' : '[05] CONTACT'}</a></nav>
    <div class="footer__socials">{socials.map(([label, href]) => <a href={href} target="_blank" rel="noopener noreferrer">{label} ↗</a>)}</div>
  </div>
  <div class="footer__wordmark" data-footer-wordmark aria-hidden="true">DEVENAS</div>
  <div class="footer__bottom mono"><span>©2026 DEVENAS</span><a href={`/${lang}/privacy/`}>{ru ? 'ПОЛИТИКА КОНФИДЕНЦИАЛЬНОСТИ' : 'PRIVACY POLICY'}</a>{ru ? <span>*МЕТА — ЗАПРЕЩЁННАЯ В РФ ОРГАНИЗАЦИЯ</span> : <span>{content.footer}</span>}<a href="#top">{content.top}</a></div>
</footer>

<style>
  .section-cap{display:flex;justify-content:space-between;gap:16px;padding:12px var(--gutter);border-top:1px solid var(--line);border-bottom:1px solid var(--line);font-size:11px;color:var(--muted)}.section-cap span:first-child{color:var(--lime)}
  .faq h2,.contact h2{font-family:var(--font-display);font-weight:600;letter-spacing:-.035em}
  /* FAQ */
  .faq__layout{display:grid;grid-template-columns:1fr}
  .faq__side{padding:48px var(--gutter);border-bottom:1px solid var(--line)}
  .faq h2{font-size:clamp(30px,3.3vw,48px);line-height:1.22;margin-bottom:24px}.faq h2 .marker-blue{display:inline;padding:2px 12px 4px 10px;box-decoration-break:clone;-webkit-box-decoration-break:clone}
  .faq__hint{max-width:30ch;color:var(--muted-strong);margin-bottom:40px}
  .faq__card{display:grid;grid-template-columns:64px 1fr;gap:12px 16px;align-items:center;max-width:340px;padding:18px;background:var(--ink);color:var(--dark);box-shadow:8px 8px 0 var(--tomato);transform:rotate(-3deg)}
  .faq__card img{width:64px;height:64px;object-fit:cover;background:var(--lime)}.faq__card strong{display:block;font:600 21px/1.1 var(--font-display);letter-spacing:-.03em;margin-bottom:6px}.faq__card .mono{font-size:9px}
  .faq__card-btn{grid-column:1/-1;display:flex;justify-content:space-between;background:var(--dark);color:var(--ink);padding:14px 14px;font-size:10px;font-weight:700}
  .faq__list{border-bottom:1px solid var(--line)}
  .faq__item{width:100%;display:grid;grid-template-columns:52px 1fr 40px;text-align:left;gap:8px 12px;padding:24px var(--gutter);border-top:1px solid var(--line);color:var(--ink);transition:color var(--dur-base) var(--ease-out)}.faq__item:first-child{border-top:0}
  .faq__number,.faq__sign{font-size:11px;color:var(--muted)}.faq__sign{text-align:right;color:var(--ink)}
  .faq__question{font-size:clamp(17px,1.7vw,22px);line-height:1.3}
  .faq__answer{grid-column:2 / 3;max-height:0;overflow:hidden;color:var(--muted-strong);max-width:62ch;font-size:15px;transition:max-height var(--dur-base) var(--ease-out),padding var(--dur-base) var(--ease-out)}
  .faq__item:hover .faq__question{color:var(--lime)}.faq__item[aria-expanded='true'] .faq__question,.faq__item[aria-expanded='true'] .faq__number,.faq__item[aria-expanded='true'] .faq__sign{color:var(--lime)}
  .faq__item[aria-expanded='true'] .faq__answer{max-height:220px;padding-top:6px}
  /* Contact */
  .contact{background:var(--blue);color:var(--white);border-top:0}.contact .section-cap{border-color:rgba(255,255,255,.28);color:rgba(255,255,255,.78)}.contact .section-cap span:first-child{color:var(--lime)}
  .contact__grid{display:grid;grid-template-columns:1fr}
  .contact__copy{padding:48px var(--gutter)}
  .contact h2{font-size:clamp(46px,7vw,104px);line-height:1.1;margin-bottom:28px}.contact h2 .marker-lime{padding:0 14px 6px 10px}
  .contact__copy>p:first-of-type{max-width:30ch;font-size:clamp(17px,1.6vw,22px);line-height:1.45;color:rgba(255,255,255,.92);margin:0 0 36px}
  .contact__direct{display:block;font-size:11px;color:var(--white);margin-bottom:14px}
  .contact__links{display:grid;grid-template-columns:1fr;border-top:1px solid rgba(255,255,255,.35);max-width:640px}
  .contact__links a{display:grid;grid-template-columns:auto 1fr auto;gap:14px;align-items:center;padding:16px 0;border-bottom:1px solid rgba(255,255,255,.35);font:12px var(--font-mono);text-transform:uppercase}
  .contact__links b{font-weight:700}.contact__links span{color:rgba(255,255,255,.72);text-transform:none}.contact__links i{font-style:normal}
  .contact__links li:first-child b{color:var(--lime)}.contact__links a:hover{background:rgba(255,255,255,.1)}
  .contact__meta{font-size:10px;color:rgba(255,255,255,.62);margin:22px 0 0}
  .contact__expectation{max-width:44ch;font-size:13px;line-height:1.6;color:rgba(255,255,255,.85);margin-top:22px}
  .contact__card{padding:0 var(--gutter) 56px}
  .contact__tabs{display:grid;grid-template-columns:repeat(3,1fr);background:var(--dark);border-bottom:1px solid var(--line);font-size:10px;color:var(--muted)}.contact__tabs span{padding:14px 10px;text-align:center}.contact__tabs .is-active{background:var(--lime);color:var(--dark);font-weight:700}
  .contact__form{display:flex;flex-direction:column;gap:22px;padding:28px;background:var(--dark);box-shadow:10px 10px 0 var(--lime);color:var(--ink)}
  .contact__form h3{font:600 clamp(22px,2.2vw,30px)/1.15 var(--font-display);letter-spacing:-.03em;margin:0}
  .contact__form label{display:flex;flex-direction:column;gap:8px;color:var(--muted);font-size:10px}
  .contact__form input,.contact__form select{border:0;border-bottom:1px solid rgba(244,241,234,.5);background:transparent;color:var(--ink);font:17px var(--font-body);padding:9px 0;outline:none}.contact__form select option{background:var(--surface);color:var(--ink)}.contact__form input:focus,.contact__form select:focus{border-color:var(--lime)}
  .contact__foot{display:flex;justify-content:space-between;align-items:center;gap:16px;margin-top:8px}.contact__step{font-size:10px;color:var(--muted)}
  .contact__note{font-size:12px;line-height:1.6;color:var(--muted-strong)}
  /* Footer */
  .footer{background:var(--bg);border-top:1px solid var(--line)}
  .footer__top{display:flex;flex-wrap:wrap;justify-content:space-between;gap:16px 32px;padding:22px var(--gutter);border-bottom:1px solid var(--line);font-size:11px}.footer__top nav,.footer__socials{display:flex;flex-wrap:wrap;gap:12px 28px}.footer__top a:hover{color:var(--lime)}.footer__socials a{font-weight:700}
  .footer__wordmark{padding:0;font:900 16vw/.8 var(--font-display);letter-spacing:-.05em;white-space:nowrap;color:var(--ink);overflow:hidden;margin:24px 0 16px;text-align:left}
  .footer__bottom{display:flex;flex-wrap:wrap;justify-content:space-between;gap:12px 24px;padding:16px var(--gutter);border-top:1px solid var(--line);font-size:10px;color:var(--muted)}.footer__bottom a{color:var(--ink)}.footer__bottom a:hover{color:var(--lime)}
  @media(min-width:900px){.faq__layout{grid-template-columns:560px 1fr}.faq__side{border-bottom:0;border-right:1px solid var(--line)}.faq__list{border-bottom:0}.faq__item{padding:24px 32px}.contact__grid{grid-template-columns:1fr 1fr}.contact__copy{padding:72px var(--gutter) 72px;border-right:1px solid rgba(255,255,255,.28)}.contact__card{padding:64px var(--gutter) 72px 56px}.contact__links{grid-template-columns:1fr 1fr;column-gap:56px}.contact__links a{grid-template-columns:auto 1fr auto}}
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-faq] .faq__item').forEach((button) => button.addEventListener('click', () => {
    const open = button.getAttribute('aria-expanded') === 'true';
    document.querySelectorAll('[data-faq] .faq__item').forEach((item) => {
      item.setAttribute('aria-expanded', 'false');
      const sign = item.querySelector('.faq__sign');
      if (sign) sign.textContent = '[+]';
    });
    button.setAttribute('aria-expanded', String(!open));
    const sign = button.querySelector('.faq__sign');
    if (sign) sign.textContent = open ? '[+]' : '[−]';
  }));

  const wordmark = document.querySelector<HTMLElement>('[data-footer-wordmark]');
  if (wordmark) {
    const fit = () => {
      const width = wordmark.clientWidth;
      if (!width) return;
      wordmark.style.fontSize = '100px';
      wordmark.style.width = 'max-content';
      const natural = wordmark.getBoundingClientRect().width;
      wordmark.style.width = '';
      if (natural > 0) wordmark.style.fontSize = `${(width / natural) * 100}px`;
    };
    fit();
    document.fonts?.ready.then(fit).catch(() => {});
    window.addEventListener('resize', fit);
  }
</script>
