---
interface Props {
  src: string;
  alt: string;
  loading?: 'eager' | 'lazy';
  sizes?: string;
  class?: string;
}
const { src, alt, loading = 'lazy', sizes = '(max-width: 767px) 100vw, 50vw', class: className } = Astro.props;
const optimized = (width: number) => src.replace('/assets/', '/assets/optimized/').replace(/\.[^.]+$/, `-${width}.webp`);
---
<picture class={className}>
  <source type="image/webp" srcset={`${optimized(640)} 640w, ${optimized(1600)} 1600w`} sizes={sizes} />
  <img src={src} alt={alt} loading={loading} decoding="async" />
</picture>
<style>picture{display:block}img{width:100%;height:100%;object-fit:inherit;object-position:inherit}</style>
