---
import { reviews } from '../data/proof';
import type { Locale } from '../lib/i18n';
const { lang, slug } = Astro.props as { lang: Locale; slug?: string };
const ru = lang === 'ru';
const items = slug ? reviews.filter((review) => review.slug === slug) : reviews;
const total = String(items.length).padStart(2, '0');
---
{items.length > 0 && !slug && <section class="reviews reviews--tabs" id="reviews" aria-labelledby="reviews-title">
  <div class="reviews__cap mono"><span id="reviews-title">{ru ? '[04] ОТЗЫВЫ' : '[04] REVIEWS'}</span><span data-rv-counter>01 / {total}</span></div>
  <div class="rv">
    <div class="rv__tabs" role="tablist" aria-label={ru ? 'Отзывы клиентов' : 'Client reviews'}>
      {items.map((review, i) => <button class="rv__tab" type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-rv-tab={i}>
        <span class="rv__tab-name">({String(i + 1).padStart(2, '0')}) {review.name[lang]}</span>
        <span class="mono rv__tab-ctx">{review.context[lang]}</span>
      </button>)}
    </div>
    <div class="rv__panel">
      <span class="rv__mark" aria-hidden="true">«</span>
      {items.map((review, i) => <figure class="rv__slide" data-rv-slide={i} hidden={i !== 0}>
        <blockquote><p>{review.quote[lang]}</p></blockquote>
        <figcaption>
          <strong>{review.name[lang]}</strong>
          <span class="mono">{review.context[lang]}</span>
          <span class="rv__links mono"><a href={`/${lang}/cases/${review.slug}/`}>{ru ? 'Посмотреть проект ↗' : 'View the project ↗'}</a>{review.site && <a href={review.site} target="_blank" rel="noopener noreferrer">{ru ? 'Открыть сайт ↗' : 'Live website ↗'}</a>}{review.source && <a href={review.source} target="_blank" rel="noopener noreferrer">{ru ? 'Профиль с отзывами на Avito ↗' : 'Avito review profile ↗'}</a>}</span>
        </figcaption>
      </figure>)}
      <div class="rv__arrows"><button type="button" data-rv-prev aria-label={ru ? 'Предыдущий отзыв' : 'Previous review'}>←</button><button type="button" data-rv-next aria-label={ru ? 'Следующий отзыв' : 'Next review'}>→</button></div>
    </div>
  </div>
</section>}
{items.length > 0 && !!slug && <section class:list={['reviews', 'reviews--single']} id="reviews" aria-labelledby="reviews-title">
  <div class="reviews__cap mono"><span>{ru ? '[ ОТЗЫВЫ КЛИЕНТОВ ]' : '[ CLIENT REVIEWS ]'}</span><span>{ru ? 'О РАБОТЕ — ИЗ ПЕРВЫХ РУК' : 'IN THEIR OWN WORDS'}</span></div>
  <div class="reviews__intro"><h2 id="reviews-title">{ru ? 'Не только красивый сайт.' : 'More than a good-looking site.'}<br /><span>{ru ? 'Комфортная работа вместе.' : 'A good experience together.'}</span></h2><p>{ru ? 'Сроки, внимание к задаче и понятное общение. Вот что отмечают клиенты после работы.' : 'Timely delivery, attention to the task and clear communication. What clients say after working together. Reviews translated from Russian.'}</p></div>
  {!slug && <div class="reviews__nav" data-reviews-nav>
    <span class="mono reviews__swipe">{ru ? 'ЛИСТАЙТЕ ОТЗЫВЫ →' : 'BROWSE REVIEWS →'}</span>
    <div class="reviews__buttons"><span class="mono" data-reviews-counter aria-live="polite">01 / {total}</span><button type="button" data-reviews-prev aria-label={ru ? 'Предыдущий отзыв' : 'Previous review'}>←</button><button type="button" data-reviews-next aria-label={ru ? 'Следующий отзыв' : 'Next review'}>→</button></div>
  </div>}
  <div class="reviews__viewport" data-reviews-viewport tabindex={slug ? undefined : 0} aria-label={ru ? 'Отзывы клиентов' : 'Client reviews'}><div class="reviews__grid">{items.map((review, i) => <figure class="review">
    <span class="review__number mono">{String(i + 1).padStart(2, '0')} / {total}<span aria-hidden="true">“</span></span>
    <blockquote><p>{review.quote[lang]}</p></blockquote>
    <figcaption><strong>{review.name[lang]}</strong><span class="mono">{review.context[lang]}</span></figcaption>
    <div class="review__links mono">{!slug && <a href={`/${lang}/cases/${review.slug}/`}>{ru ? 'Посмотреть проект ↗' : 'View the project ↗'}</a>}{review.site && <a href={review.site} target="_blank" rel="noopener noreferrer">{ru ? 'Открыть сайт ↗' : 'Live website ↗'}</a>}{review.source && <a href={review.source} target="_blank" rel="noopener noreferrer">{ru ? 'Профиль с отзывами на Avito ↗' : 'Avito review profile ↗'}</a>}</div>
  </figure>)}</div></div>
  {!slug && <div class="reviews__next"><p>{ru ? 'Есть задача? Начнём с короткого знакомства.' : 'Have a project in mind? Let’s start with a conversation.'}<span>{ru ? 'Расскажите о бизнесе — предложу формат, сроки и стоимость.' : 'Tell me about your business — I’ll suggest a format, timeline and price.'}</span></p><button type="button" data-open-brief class="btn btn-primary hard-shadow-lime">{ru ? 'Обсудить проект ↗' : 'Discuss a project ↗'}</button></div>}
</section>}
<style>
  .reviews--tabs{background:var(--bg);border-top:0}.reviews--tabs .reviews__cap{padding:12px var(--gutter);font-size:11px}
  .rv{display:grid;grid-template-columns:1fr;border-bottom:1px solid var(--line)}
  .rv__tabs{display:flex;flex-direction:row;overflow-x:auto;scrollbar-width:none;border-bottom:1px solid var(--line)}.rv__tabs::-webkit-scrollbar{display:none}
  .rv__tab{flex:0 0 auto;min-width:220px;text-align:left;display:flex;flex-direction:column;gap:8px;padding:24px var(--gutter);border-right:1px solid var(--line);color:var(--muted-strong);transition:background var(--dur-base) var(--ease-out),color var(--dur-base) var(--ease-out)}
  .rv__tab-name{font-family:var(--font-display);font-weight:600;font-size:clamp(17px,1.6vw,22px);letter-spacing:-.02em;line-height:1.15}.rv__tab-ctx{font-size:10px;opacity:.8}
  .rv__tab:hover{color:var(--ink)}.rv__tab[aria-selected='true']{background:var(--tomato);color:var(--dark)}
  .rv__panel{position:relative;padding:40px var(--gutter) 96px}
  .rv__mark{display:block;font:900 clamp(80px,9vw,140px)/.7 var(--font-display);color:var(--lime);letter-spacing:-.1em;margin-bottom:28px}
  .rv__slide{margin:0;display:flex;flex-direction:column;gap:32px}.rv__slide[hidden]{display:none}
  .rv__slide blockquote{margin:0;max-width:26em;font-family:var(--font-display);font-weight:600;font-size:clamp(20px,2.5vw,36px);line-height:1.25;letter-spacing:-.03em}
  .rv__slide figcaption{display:flex;flex-direction:column;gap:6px;max-width:44em}.rv__slide figcaption strong{font-family:var(--font-mono);font-size:12px;text-transform:uppercase;letter-spacing:.02em}.rv__slide figcaption .mono{font-size:10px;color:var(--muted)}
  .rv__links{display:flex;flex-wrap:wrap;gap:20px;margin-top:12px}.rv__links a{color:var(--ink);border-bottom:1px solid var(--line);padding-bottom:4px;font-size:10px}.rv__links a:hover{color:var(--lime)}
  .rv__arrows{position:absolute;right:var(--gutter);bottom:32px;display:flex}.rv__arrows button{width:58px;height:56px;display:grid;place-items:center;border:1px solid var(--line);font:18px/1 var(--font-display)}.rv__arrows button+button{background:var(--ink);color:var(--dark);border-color:var(--ink)}.rv__arrows button:hover{background:var(--lime);border-color:var(--lime);color:var(--dark)}
  @media(min-width:900px){.rv{grid-template-columns:360px 1fr}.rv__tabs{flex-direction:column;overflow:visible;border-bottom:0;border-right:1px solid var(--line)}.rv__tab{min-width:0;border-right:0;border-bottom:1px solid var(--line);padding:26px 32px}.rv__panel{padding:72px 64px 104px 64px;min-height:520px}}
  .reviews{border-top:1px solid var(--line);background:var(--surface)}.reviews__cap{display:flex;justify-content:space-between;gap:16px;padding:16px var(--gutter);border-bottom:1px solid var(--line);font-size:10px;color:var(--muted)}.reviews__cap span:first-child{color:var(--lime)}
  .reviews__intro{display:grid;grid-template-columns:2fr 1fr;gap:40px;padding:56px var(--gutter) 40px;align-items:end}.reviews h2{font:600 clamp(24px,3.1vw,42px)/1.25 var(--font-display);letter-spacing:-.035em}.reviews h2 span{color:var(--lime)}.reviews__intro>p{color:var(--muted-strong);max-width:40ch;font-size:15px}
  .reviews__nav{display:flex;justify-content:space-between;align-items:center;padding:0 var(--gutter) 16px}.reviews__swipe,.reviews__buttons{font-size:10px}.reviews__swipe{color:var(--muted)}.reviews__buttons{display:flex;align-items:center;gap:8px}.reviews__buttons span{color:var(--lime);min-width:58px}.reviews__buttons button{width:34px;height:34px;display:grid;place-items:center;border:1px solid var(--line);font:18px/1 var(--font-display)}.reviews__buttons button:hover:not(:disabled){background:var(--lime);border-color:var(--lime);color:var(--dark)}.reviews__buttons button:disabled{opacity:.3;cursor:default}
  .reviews__viewport{overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;padding:0 var(--gutter) 6px;overscroll-behavior-x:contain}.reviews__viewport::-webkit-scrollbar{display:none}.reviews__grid{display:flex;gap:16px;width:max-content}.review{box-sizing:border-box;flex:0 0 calc((100vw - (var(--gutter) * 2) - 16px)/2);min-height:356px;margin:0;padding:32px;display:flex;flex-direction:column;border:1px solid var(--line);background:var(--bg);gap:24px;scroll-snap-align:start;scroll-snap-stop:always}.review__number{color:var(--lime);font-size:11px;display:flex;align-items:center;justify-content:space-between}.review__number>span{font:48px/.5 var(--font-display)}.review blockquote{margin:0;flex:1;max-width:60ch;font-size:clamp(17px,1.5vw,21px);line-height:1.55}.review figcaption{display:flex;flex-direction:column;gap:8px}.review figcaption strong{font-size:15px}.review figcaption .mono{font-size:10px;color:var(--muted)}.review__links{display:flex;gap:24px;flex-wrap:wrap;font-size:10px}.review__links a{border-bottom:1px solid var(--line);padding-bottom:4px}.review__links a:hover{color:var(--lime)}
  .reviews__next{display:flex;align-items:center;justify-content:space-between;gap:32px;padding:32px var(--gutter) 40px}.reviews__next p{font-size:20px}.reviews__next p span{display:block;color:var(--muted-strong);font-size:14px;margin-top:8px}.reviews__next button{flex-shrink:0}.reviews--single .reviews__grid{grid-template-columns:1fr}.reviews--single .review{border-right:0}.reviews--single blockquote{max-width:75ch}
  .reviews--single .reviews__viewport{overflow:visible;padding:0}.reviews--single .reviews__grid{display:block;width:auto}.reviews--single .review{display:flex;width:auto;min-height:0;border-left:0;border-right:0;background:transparent;padding:28px var(--gutter)}
  @media(max-width:767px){.reviews__intro{grid-template-columns:1fr;gap:20px;padding-top:40px;padding-bottom:24px}.reviews__swipe{font-size:9px}.reviews__buttons span{min-width:42px}.reviews__grid{gap:12px}.review{flex-basis:calc(100vw - 88px);min-height:360px;padding:24px;gap:18px}.review__number>span{font-size:40px}.review blockquote{font-size:17px;line-height:1.5}.review figcaption strong{font-size:14px}.review__links{gap:16px}.reviews__next{align-items:flex-start;flex-direction:column;padding-top:32px}.reviews__cap>span:last-child{display:none}.reviews--single .review{padding:28px var(--gutter)}}
</style>

{!slug && <script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-rv-tab]'));
  const slides = Array.from(document.querySelectorAll<HTMLElement>('[data-rv-slide]'));
  const counter = document.querySelector<HTMLElement>('[data-rv-counter]');
  let current = 0;
  const show = (index: number) => {
    if (!tabs.length) return;
    current = (index + tabs.length) % tabs.length;
    tabs.forEach((tab, i) => tab.setAttribute('aria-selected', String(i === current)));
    slides.forEach((slide, i) => { slide.hidden = i !== current; });
    if (counter) counter.textContent = `${String(current + 1).padStart(2, '0')} / ${String(tabs.length).padStart(2, '0')}`;
  };
  tabs.forEach((tab, i) => tab.addEventListener('click', () => show(i)));
  document.querySelector('[data-rv-prev]')?.addEventListener('click', () => show(current - 1));
  document.querySelector('[data-rv-next]')?.addEventListener('click', () => show(current + 1));
</script>}
