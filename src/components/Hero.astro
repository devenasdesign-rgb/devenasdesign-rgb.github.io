---
import type { Locale } from '../lib/i18n';
import ProjectImage from './ProjectImage.astro';

interface Props {
  lang: Locale;
  hero: {
    caption: string;
    avatarSticker: string;
    heading: { pre: string; marker: string; post: string };
    subheading: string;
    reassurance: string;
    proof: { text: string; href: string };
    statsLine: string;
    primaryButton: string;
    secondaryButton: string;
    viewWorkLink: string;
    segments: { label: string; href: string }[];
  };
}

const { hero, lang } = Astro.props;
const withLang = (href: string) => (href.startsWith('#') ? href : `/${lang}${href}`);
---

<section class="hero">
  <div class="hero__inner">
    <div class="hero__copy">
      <p class="hero__caption mono">{hero.caption}</p>
      <h1 class="hero__heading">
        {hero.heading.pre}<span class="marker-lime">{hero.heading.marker}</span>{hero.heading.post}
      </h1>
      <p class="hero__subheading">{hero.subheading}</p>

      <div class="hero__buttons">
        <button class="btn btn-primary hard-shadow-lime" type="button" data-open-brief>{hero.primaryButton}</button>
        <a class="btn btn-secondary" href="https://t.me/devenas" target="_blank" rel="noopener noreferrer">{hero.secondaryButton}</a>
      </div>
      <a class="hero__viewwork mono" href="#work">{hero.viewWorkLink}</a>

      <div class="hero__segments mono">
        {hero.segments.map((s) => <a href={withLang(s.href)}>{s.label} →</a>)}
      </div>

      <p class="hero__reassurance mono">{hero.reassurance}</p>
      <a class="hero__proof mono" href={withLang(hero.proof.href)}>{hero.proof.text}</a>
      <p class="hero__stats mono">{hero.statsLine}</p>
    </div>

    <div class="hero__photo-col">
      <div class="hero__photo-frame">
        <ProjectImage class="hero__photo" src="/assets/founder/anastasia.png" alt="Анастасия Девентейчик" sizes="(max-width: 899px) 70vw, 360px" />
        <span class="hero__photo-tag mono">{hero.avatarSticker}</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 32px var(--gutter) 40px;
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: start;
  }

  .hero__caption {
    font-size: 11px;
    color: var(--muted);
    margin-bottom: 16px;
  }

  .hero__heading {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(30px, 5.2vw, 56px);
    line-height: 1.12;
    letter-spacing: -0.03em;
    margin: 0 0 20px;
  }

  .hero__heading .marker-lime {
    padding: 2px 12px 4px 8px;
  }

  .hero__subheading {
    color: var(--muted-strong);
    font-size: clamp(16px, 1.6vw, 19px);
    line-height: 1.5;
    max-width: 52ch;
    margin-bottom: 28px;
  }

  .hero__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 14px;
  }

  .hero__viewwork {
    display: inline-block;
    font-size: 11px;
    color: var(--muted-strong);
    border-bottom: 1px solid var(--line);
    padding-bottom: 3px;
    margin-bottom: 28px;
    transition: color var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out);
  }
  .hero__viewwork:hover {
    color: var(--lime);
    border-color: var(--lime);
  }

  .hero__segments {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 24px;
  }
  .hero__segments a {
    font-size: 11px;
    padding: 9px 14px;
    border: 1px solid var(--line);
    color: var(--ink);
    transition: background var(--dur-base) var(--ease-out), color var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out);
  }
  .hero__segments a:hover {
    background: var(--lime);
    color: var(--dark);
    border-color: var(--lime);
  }

  .hero__reassurance {
    font-size: 10px;
    color: var(--muted);
    margin-bottom: 16px;
  }

  .hero__proof {
    display: inline-block;
    font-size: 12px;
    color: var(--ink);
    background: rgba(212, 255, 58, 0.1);
    border: 1px solid rgba(212, 255, 58, 0.35);
    padding: 10px 14px;
    margin-bottom: 24px;
    max-width: 46ch;
    transition: background var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out);
  }
  .hero__proof:hover {
    background: var(--lime);
    color: var(--dark);
    border-color: var(--lime);
  }

  .hero__stats {
    font-size: 11px;
    color: var(--muted);
  }

  .hero__photo-col {
    display: flex;
    justify-content: center;
  }

  .hero__photo-frame {
    position: relative;
    width: 100%;
    max-width: 320px;
    aspect-ratio: 4 / 5;
    background: var(--surface);
    border: 1px solid var(--line);
  }

  .hero__photo-frame :global(picture),
  .hero__photo-frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .hero__photo-tag {
    position: absolute;
    left: -10px;
    bottom: -14px;
    background: var(--ink);
    color: var(--dark);
    padding: 8px 14px;
    font-size: 11px;
    box-shadow: 6px 6px 0 0 var(--tomato);
    transform: rotate(-4deg);
  }

  @media (min-width: 900px) {
    .hero {
      padding-top: 56px;
      padding-bottom: 64px;
    }
    .hero__inner {
      grid-template-columns: 1.4fr 1fr;
      gap: 56px;
    }
    .hero__photo-col {
      justify-content: flex-end;
    }
    .hero__photo-frame {
      max-width: 380px;
    }
  }
</style>
