---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import AboutMe from '../../components/AboutMe.astro';
import Work from '../../components/Work.astro';
import Reviews from '../../components/Reviews.astro';
import Services from '../../components/Services.astro';
import Process from '../../components/Process.astro';
import MoreSections from '../../components/MoreSections.astro';
import BriefModal from '../../components/BriefModal.astro';
import FloatingContact from '../../components/FloatingContact.astro';
import { locales, getSiteData, type Locale } from '../../lib/i18n';
import { seo } from '../../data/seo';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const data = getSiteData(lang);

const titles: Record<Locale, string> = {
  ru: 'Веб-дизайнер Анастасия Девентейчик — сайты на Tilda и в коде | DEVENAS',
  en: 'Web designer Anastasia Deventeichik — Tilda & custom-code websites | DEVENAS',
};
const descriptions: Record<Locale, string> = {
  ru: 'Анастасия Девентейчик — веб-дизайнер. Создаю лендинги, многостраничные сайты и интернет-магазины для малого бизнеса и экспертов на Tilda и в коде. Цены открытые, расчёт за 1 день.',
  en: 'Anastasia Deventeichik is a web designer. I build landing pages, multi-page websites and online stores for small businesses and experts on Tilda and in code. Open pricing, quote within a day.',
};

const ru = lang === 'ru';
const origin = seo.origin;
const price: Record<string, { amount: number; currency: string }> = ru
  ? { onepage: { amount: 55000, currency: 'RUB' }, multipage: { amount: 80000, currency: 'RUB' }, store: { amount: 120000, currency: 'RUB' }, design: { amount: 40000, currency: 'RUB' } }
  : { onepage: { amount: 900, currency: 'USD' }, multipage: { amount: 1400, currency: 'USD' }, store: { amount: 2200, currency: 'USD' }, design: { amount: 700, currency: 'USD' } };

const person = {
  '@type': 'Person',
  '@id': `${origin}/#person`,
  name: ru ? 'Анастасия Девентейчик' : 'Anastasia Deventeichik',
  alternateName: 'DEVENAS',
  jobTitle: ru ? 'Веб-дизайнер' : 'Web designer',
  url: `${origin}/${lang}/`,
  image: `${origin}/assets/founder/anastasia.png`,
  sameAs: seo.sameAs,
  knowsAbout: ru
    ? ['веб-дизайн', 'Tilda', 'сайты для малого бизнеса', 'лендинги', 'интернет-магазины', 'UX/UI дизайн']
    : ['web design', 'Tilda', 'websites for small business', 'landing pages', 'online stores', 'UX/UI design'],
  knowsLanguage: ['ru', 'en'],
};
const service = {
  '@type': 'ProfessionalService',
  '@id': `${origin}/#service`,
  name: 'DEVENAS',
  url: `${origin}/${lang}/`,
  image: `${origin}${seo.ogImage}`,
  description: descriptions[lang],
  founder: { '@id': `${origin}/#person` },
  areaServed: ru ? 'Россия и весь мир' : 'Worldwide',
  availableLanguage: ['ru', 'en'],
  sameAs: seo.sameAs,
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: data.services.sectionLabel.replace(/^\[\d+\]\s*/, ''),
    itemListElement: data.services.items.map((item) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: item.title, description: item.forWho },
      priceSpecification: {
        '@type': 'PriceSpecification',
        minPrice: price[item.id].amount,
        priceCurrency: price[item.id].currency,
      },
    })),
  },
};
const website = {
  '@type': 'WebSite',
  '@id': `${origin}/#website`,
  url: `${origin}/${lang}/`,
  name: 'DEVENAS',
  inLanguage: lang,
  publisher: { '@id': `${origin}/#person` },
};
const jsonLd = { '@context': 'https://schema.org', '@graph': [person, service, website] };
---

<Base lang={lang} title={titles[lang]} description={descriptions[lang]} image={lang === 'en' ? '/og-image-en.png' : '/og-image.png'} jsonLd={jsonLd}>
  <Header lang={lang} {...data.header} />
  <main>
    <Hero lang={lang} hero={data.hero} />
    <AboutMe about={data.about} />
    <Work lang={lang} work={data.work} />
    <Services lang={lang} services={data.services} />
    <Process process={data.process} />
    <Reviews lang={lang} />
    <MoreSections lang={lang} />
    <BriefModal lang={lang} />
    <FloatingContact lang={lang} />
  </main>
</Base>
