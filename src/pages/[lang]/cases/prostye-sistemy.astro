---
// Развёрнутая версия кейса «Простые системы» — один в один с макетом из Фигмы,
// со всеми материалами процесса (варианты логотипа, прототипы, карта сайта, итоговая панель, отзыв).
// Фото и графика экспортированы из Фигмы: public/assets/cases/prostye-sistemy/figma/*
// (исходники также лежат в папке «кейс простые системы» в корне проекта).
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import BriefModal from '../../../components/BriefModal.astro';
import FloatingContact from '../../../components/FloatingContact.astro';
import { projects } from '../../../data/proof';
import { doubts } from '../../../data/doubts';
import { locales, getSiteData, isLocale, type Locale } from '../../../lib/i18n';
import { seo } from '../../../data/seo';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang: rawLang } = Astro.params;
if (!rawLang || !isLocale(rawLang)) throw new Error('Unknown locale');
const lang = rawLang as Locale;
const ru = lang === 'ru';
const data = getSiteData(lang);
const slug = 'prostye-sistemy';
const item = data.work.items.find((entry) => entry.slug === slug)!;
const project = projects[slug];
const story = project[lang];
const index = data.work.items.findIndex((entry) => entry.slug === slug);
const next = data.work.items[(index + 1) % data.work.items.length];
const caseDoubts = doubts[slug]?.[lang] ?? [];

const img = (name: string) => `/assets/cases/prostye-sistemy/figma/${name}`;

const t = ru
  ? {
      back: '← ВСЕ РАБОТЫ',
      label: '[ КЕЙС ] · САЙТ И ЛОГОТИП',
      title: 'Простые системы',
      subtitle: 'Инженерные системы',
      lead: 'Разработка проекта под ключ от логотипа до многостраничного сайта',
      tags: ['РЕАЛЬНЫЙ', 'TILDA'],
      status: 'КЛИЕНТСКИЙ ПРОЕКТ · ОПУБЛИКОВАН',
      openSite: 'ОТКРЫТЬ САЙТ ПРОЕКТА ↗',
      counter: (i: number, n: number) => `${String(i).padStart(2, '0')}/${String(n).padStart(2, '0')}`,

