      aboutBody: 'Компания из Подмосковья проектирует и монтирует отопление, водоснабжение, канализацию и водоочистку. Работает с владельцами загородных домов, коммерческими объектами и застройщиками — для них важно, чтобы системы работали без аварий, а подрядчик был надёжным.',

      part01: 'ЧАСТЬ 01',
      part01Title: 'Логотип и фирменный стиль',
      ideaLabel: 'ИДЕЯ',
      ideaHeading: 'С чего начали: дом из трёх решений',
      ideaBody: 'Старый логотип компании нельзя было зарегистрировать как товарный знак — типичная проблема готовых шаблонов. Отталкивалась от сути бизнеса: «Простые системы» делают три вещи — отопление, электрику и воду. Идея — показать это одним знаком, не текстом. Так родился силуэт дома, собранный из трёх геометрических форм.',
      variantsLabel: 'ВАРИАНТЫ',
      variantsHeading: 'Предложила три направления — выбрали одно',
      variantsBody: 'От абстрактного знака до буквального силуэта дома. Заказчик выбрал средний вариант — узнаваемый, но не буквальный.',
      variantsCaption: 'Поиск знака: от абстрактных вариантов к силуэту дома. Финальный вариант сразу проверяли на светлом и тёмном фоне.',
      logoLabel: 'ЛОГОТИП',
      logoHeading: 'Знак, который можно зарегистрировать',
      logoBody: 'Силуэт дома из трёх геометрических элементов — простая форма, которую легко узнать и юридически защитить.',
      colors: [
        ['ЗЕЛЁНЫЙ', 'ЭНЕРГИЯ И ЭЛЕКТРИЧЕСТВО'],
        ['ЖЁЛТЫЙ', 'ТЕПЛО'],
        ['СИНИЙ', 'ВОДА'],
      ],
      badge: 'Товарный знак зарегистрирован',

      part02: 'ЧАСТЬ 02',
      part02Title: 'Сайт',
      goalLabel: 'ЦЕЛЬ',
      goalHeading: 'Сайт, которому доверяют с первого экрана',
      goalBody: 'С готовым знаком перешла к сайту. Цель — с десятками технически сложных услуг клиент должен за 5 секунд понять, что делает компания, и за 2 клика оставить заявку. Начала не с экранов, а со структуры.',
      structLabel: 'СТРУКТУРА',
      structHeading: 'От цели — к карте сайта',
      structBody: 'Каждое направление услуг получило отдельную страницу — под неё можно настраивать SEO и рекламу.',
      sitemapCaption: 'Каждое направление получило отдельную страницу — под неё можно настраивать SEO и рекламу по конкретной услуге.',
      sitemap: {
        title: 'КАРТА САЙТА',
        root: 'Главная',
        categories: [
          { label: 'Услуги', active: true },
          { label: 'Стоимость' },
          { label: 'О компании' },
          { label: 'Лицензии' },
          { label: 'Контакты' },
        ],
        services: ['Отопление и тёплые полы', 'Котлы', 'Водоснабжение и водоочистка', 'Канализация', 'Сантехника', 'Дымоходы и вентиляция', 'Автоматика', 'Доп. услуги'],
      },
      processLabel: 'ПРОЦЕСС',
      processHeading: 'Как искали логотип и собирали структуру сайта',
      processCaption: 'Чёрно-белые прототипы без цвета и фото: проверяла логику страниц — от сетки услуг до контактов — ещё до того, как добавила фирменный стиль.',
      insightLabel: 'ПРОМЕЖУТОЧНЫЙ ВЫВОД',
      insightHeading: 'К чему пришла после анализа',
      insights: [
        ['Связь в один клик', 'Кнопки Telegram и мессенджеров на первом экране рядом с формой — написать проще, чем звонить незнакомому номеру.'],
        ['Десятки услуг — пять понятных направлений', 'На главной услуги сгруппированы в 5 блоков, у каждого направления своя страница. Клиент сразу находит свою задачу.'],
        ['Ставка на доверие', 'Слово директора с фото, лицензии, реальные объекты и путь работы из 10 шагов — страница «О компании» стала второй по посещаемости после главной.'],
      ],

      finalLabel: 'ФИНАЛЬНЫЙ ДИЗАЙН',
      finalHeading: 'Главная страница: десктоп и мобильная версия',
      finalCaption: 'Больше половины посетителей главной заходили с телефона, поэтому мобильную версию собирали отдельно: крупные кнопки связи и короткие блоки.',
      finalDesktopLabel: 'ДЕСКТОП',
      finalMobileLabel: 'МОБИЛЬНАЯ ВЕРСИЯ',

      outcomeLabel: 'ИТОГ',
      outcomeHeading: 'Было → стало → что дало',
      outcome: [
        ['БЫЛО', 'Логотип вне закона', 'Нельзя было зарегистрировать как товарный знак — компания без понятной подачи в интернете.'],
        ['СТАЛО', 'Единая система', 'Товарный знак, гайдлайн и сайт с отдельной страницей под каждое направление услуг.'],
        ['ЧТО ДАЛО', 'Бренду есть чем доверять', 'Защищённое имя и сайт, который приводит клиентов из поиска без рекламного бюджета.'],
      ],
      outcomeBadge: 'Товарный знак зарегистрирован',
      stat1: ['1 300+', 'переходов из поиска Яндекса без рекламы'],
      stat2: ['№ 2', 'по посещаемости — страница «О компании»'],

      reviewLabel: 'ОТЗЫВ КЛИЕНТА',
      reviewHeading: 'О работе — из первых рук',

      ctaHeading: 'Напишите слово «ЛОГОТИП», и я разберу, что мешает вашему текущему сайту продавать',
      ctaTelegram: 'TELEGRAM',
      ctaInstagram: 'INSTAGRAM*',
      ctaEmail: 'ПОЧТА',
      ctaMetaNote: '*Meta — организация, запрещённая в РФ',

      doubtsLabel: '[ КАКИЕ СОМНЕНИЯ СНИМАЕТ САЙТ ]',
      doubtsHeading: 'Что беспокоит посетителя — и как сайт отвечает',
      doubtQ: 'СОМНЕНИЕ',
      doubtA: 'ОТВЕТ САЙТА',

      more: 'СЛЕДУЮЩИЙ КЕЙС →',
    }
  : {
      back: '← ALL WORK',
      label: '[ CASE STUDY ] · WEBSITE & LOGO',
      title: 'Prostye Sistemy',
      subtitle: 'Engineering systems',
      lead: 'A turnkey project: from logo to a multi-page website',
      tags: ['LIVE', 'TILDA'],
      status: 'CLIENT PROJECT · PUBLISHED',
      openSite: 'OPEN THE LIVE SITE ↗',
      counter: (i: number, n: number) => `${String(i).padStart(2, '0')}/${String(n).padStart(2, '0')}`,

      aboutLabel: 'THE PROJECT',
      aboutHeading: 'An installation company with no clear online presence',
      aboutBody: 'A company near Moscow designs and installs heating, water supply, sewage and water-treatment systems. It works with owners of country houses, commercial facilities and developers, for whom it matters that systems run without failures and the contractor can be trusted.',

      part01: 'PART 01',
      part01Title: 'Logo and brand identity',
      ideaLabel: 'THE IDEA',
      ideaHeading: 'Where it started: a house of three solutions',
      ideaBody: 'The company’s old logo could not be registered as a trademark — a typical problem with template logos. I started from the essence of the business: Prostye Sistemy does three things — heating, electricity and water. The idea was to show this with one mark, not with text. That is how a house silhouette, built from three geometric shapes, was born.',
      variantsLabel: 'OPTIONS',
      variantsHeading: 'I proposed three directions — one was chosen',
      variantsBody: 'From an abstract mark to a literal house silhouette. The client chose the middle option: recognisable, but not too literal.',
      variantsCaption: 'Searching for the mark: from abstract options to a house silhouette. The final version was checked on light and dark backgrounds from the start.',
      logoLabel: 'THE LOGO',
      logoHeading: 'A mark that could be registered',
      logoBody: 'A house silhouette made of three geometric elements: a simple shape that is easy to recognise and to protect legally.',
      colors: [
        ['GREEN', 'ENERGY AND ELECTRICITY'],
        ['YELLOW', 'HEAT'],
        ['BLUE', 'WATER'],
      ],
      badge: 'Trademark registered',

      part02: 'PART 02',
      part02Title: 'Website',
      goalLabel: 'THE GOAL',
      goalHeading: 'A site trusted from the first screen',
      goalBody: 'With the mark ready, I moved on to the website. The goal: with dozens of technically complex services, a visitor should understand what the company does within 5 seconds, and leave a request in 2 clicks. I started not with screens, but with structure.',
      structLabel: 'STRUCTURE',
      structHeading: 'From the goal to a sitemap',
      structBody: 'Each service direction got its own page, which can be optimised for SEO and ads individually.',
      sitemapCaption: 'Each direction got its own page, so SEO and ads can be configured for that specific service.',
      sitemap: {
        title: 'SITEMAP',
        root: 'Home',
        categories: [
          { label: 'Services', active: true },
          { label: 'Pricing' },
          { label: 'About' },
          { label: 'Licenses' },
          { label: 'Contacts' },
        ],
        services: ['Heating & underfloor heating', 'Boilers', 'Water supply & treatment', 'Sewage', 'Plumbing', 'Chimneys & ventilation', 'Automation', 'Additional services'],
      },
      processLabel: 'PROCESS',
      processHeading: 'How the logo and the site’s structure were shaped',
      processCaption: 'Black-and-white prototypes with no colour or photos: I tested the logic of the pages — from the services grid to contacts — before adding the brand identity.',
      insightLabel: 'WHAT THE ANALYSIS SHOWED',
      insightHeading: 'What the analysis led to',
      insights: [
        ['Contact in one click', 'Telegram and messenger buttons on the first screen, next to the form: messaging is easier than calling an unfamiliar number.'],
        ['Dozens of services — five clear directions', 'On the homepage, services are grouped into 5 blocks, each with its own page. A client finds their task right away.'],
        ['Betting on trust', 'The director’s word with a photo, licenses, real project photos and a 10-step path — the “About” page became the second most visited page after the homepage.'],
      ],

      finalLabel: 'FINAL DESIGN',
      finalHeading: 'Homepage: desktop and mobile',
      finalCaption: 'More than half of homepage visitors came from a phone, so the mobile version was built separately: large contact buttons and short blocks.',
      finalDesktopLabel: 'DESKTOP',
      finalMobileLabel: 'MOBILE',

      outcomeLabel: 'OUTCOME',
      outcomeHeading: 'Before → after → what it gave',
      outcome: [
        ['BEFORE', 'A logo outside the law', 'It could not be registered as a trademark — a company with no clear online presence.'],
        ['AFTER', 'One coherent system', 'A registered trademark, a brand guideline and a website with a dedicated page for every service direction.'],
        ['WHAT IT GAVE', 'A brand people can trust', 'A protected name and a website that brings in clients from search with no ad budget.'],
      ],
      outcomeBadge: 'Trademark registered',
      stat1: ['1,300+', 'visits from Yandex search, with no ads'],
      stat2: ['#2', 'by traffic — the “About” page'],

      reviewLabel: 'CLIENT REVIEW',
      reviewHeading: 'About the work — first-hand',

      ctaHeading: 'Send me the word "LOGO" and I’ll tell you what’s stopping your current site from selling',
      ctaTelegram: 'TELEGRAM',
      ctaInstagram: 'INSTAGRAM*',
      ctaEmail: 'EMAIL',
      ctaMetaNote: '*Meta is recognised as an extremist organisation and is banned in Russia',

      doubtsLabel: '[ DOUBTS THIS SITE ANSWERS ]',
      doubtsHeading: 'What worries a visitor — and how the site responds',
      doubtQ: 'THE DOUBT',
      doubtA: 'THE SITE’S ANSWER',

      more: 'NEXT CASE →',
    };

const pageTitle = ru ? `${item.name} — кейс: ${item.description} | DEVENAS` : `${item.name} — case study: ${item.description} | DEVENAS`;
const pageDescription = ru
  ? 'Разворот кейса «Простые системы»: логотип и товарный знак, карта сайта, прототипы и финальный дизайн многостраничного сайта на Tilda.'
  : 'The full Prostye Sistemy case: the logo and trademark, the sitemap, prototypes and the final design of a multi-page Tilda website.';
const caseUrl = `${seo.origin}/${lang}/cases/${slug}/`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: item.name,
    description: pageDescription,
    url: caseUrl,
    image: `${seo.origin}${item.cover}`,
    inLanguage: lang,
    author: { '@type': 'Person', name: ru ? 'Анастасия Девентейчик' : 'Anastasia Deventeichik', url: `${seo.origin}/${lang}/` },
    sameAs: project.url,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'DEVENAS', item: `${seo.origin}/${lang}/` },
      { '@type': 'ListItem', position: 2, name: ru ? 'Работы' : 'Work', item: `${seo.origin}/${lang}/#work` },
      { '@type': 'ListItem', position: 3, name: item.name, item: caseUrl },
    ],
  },
];
---

<Base lang={lang} title={pageTitle} description={pageDescription} image={`/social/cases/${slug}-${lang}.png`} type="article" jsonLd={jsonLd}>
  <Header lang={lang} {...data.header} />
  <main class="ps">
    <a class="ps__back mono" href={`/${lang}/#work`}>{t.back}</a>

    <!-- Hero -->
    <section class="ps__hero">
      <div class="ps__hero-copy">
        <span class="mono ps__label ps__lime">{t.label}</span>
        <h1>{t.title}</h1>
        <p class="ps__subtitle">{t.subtitle}</p>
        <p class="ps__lead">{t.lead}</p>
        <div class="ps__tags mono">{t.tags.map((tag) => <span>{tag}</span>)}</div>
        <p class="ps__status mono">{t.status}</p>
        <a class="btn btn-primary ps__cta" href={project.url} target="_blank" rel="noopener noreferrer">{t.openSite}</a>
      </div>
      <img class="ps__hero-img" src={img('01-hero-laptop.png')} width="900" height="639" alt={t.title} loading="eager" />
    </section>

    <!-- About -->
    <section class="ps__about">
      <div>
        <h2>{t.aboutHeading}</h2>
        <span class="mono ps__tomato ps__eyebrow">{t.aboutLabel}</span>
        <p>{t.aboutBody}</p>
      </div>
      <img class="ps__about-logo" src={img('02-logo-lockup-dark.png')} width="330" height="380" alt="Простые системы" loading="lazy" />
    </section>

    <!-- Part 01 -->
    <div class="ps__band ps__band--lime">
      <span class="mono">{t.part01}</span>
      <h2>{t.part01Title}</h2>
    </div>

    <section class="ps__block">
      <span class="mono ps__tomato ps__eyebrow">[ {t.ideaLabel} ]</span>
      <h3>{t.ideaHeading}</h3>
      <p>{t.ideaBody}</p>
    </section>

    <section class="ps__block">
      <span class="mono ps__lime ps__eyebrow">[ {t.variantsLabel} ]</span>
      <h3>{t.variantsHeading}</h3>
      <p>{t.variantsBody}</p>
      <div class="ps__logo-row">
        <img src={img('24-logo-variant-1.webp')} width="500" height="367" alt="" loading="lazy" />
        <img src={img('25-logo-variant-2.webp')} width="500" height="365" alt="" loading="lazy" />
        <img src={img('03-logo-card-light.webp')} width="500" height="500" alt="" loading="lazy" />
        <img src={img('04-logo-card-dark.webp')} width="500" height="500" alt="" loading="lazy" />
      </div>
      <p class="ps__caption">{t.variantsCaption}</p>
    </section>

    <section class="ps__block ps__logo-final">
      <div class="ps__logo-final-copy">
        <span class="mono ps__lime ps__eyebrow">[ {t.logoLabel} ]</span>
        <h3>{t.logoHeading}</h3>
        <p>{t.logoBody}</p>
        <ul class="ps__colors">
          {t.colors.map(([name, label]) => (
            <li><span class={`ps__swatch ps__swatch--${name.toLowerCase()}`} aria-hidden="true"></span><span>{ru ? `${name} — ${label}` : `${name} — ${label}`}</span></li>
          ))}
        </ul>
      </div>
      <div class="ps__workwear-wrap">
        <img class="ps__workwear" src={img('07-workwear-photo.webp')} width="700" height="721" alt="" loading="lazy" />
        <span class="ps__badge mono">® {t.badge}</span>
      </div>
    </section>

    <!-- Part 02 -->
    <div class="ps__band ps__band--blue">
      <span class="mono">{t.part02}</span>
      <h2>{t.part02Title}</h2>
    </div>

    <section class="ps__block">
      <span class="mono ps__lime ps__eyebrow">[ {t.goalLabel} ]</span>
      <h3>{t.goalHeading}</h3>
      <p>{t.goalBody}</p>
    </section>

    <section class="ps__block">
      <span class="mono ps__lime ps__eyebrow">[ {t.structLabel} ]</span>
      <h3>{t.structHeading}</h3>
      <p>{t.structBody}</p>
      <div class="ps__sitemap">
        <span class="mono ps__sitemap-title">{t.sitemap.title}</span>
        <div class="ps__sitemap-tree">
          <span class="ps__sm-node ps__sm-node--root">{t.sitemap.root}</span>
          <div class="ps__sm-row">
            {t.sitemap.categories.map((c) => <span class={`ps__sm-node${c.active ? ' ps__sm-node--active' : ''}`}>{c.label}</span>)}
          </div>
          <div class="ps__sm-row ps__sm-row--sub">
            {t.sitemap.services.map((s) => <span class="ps__sm-node ps__sm-node--sub">{s}</span>)}
          </div>
        </div>
        <p class="ps__sitemap-note">{t.sitemapCaption}</p>
      </div>
    </section>

    <section class="ps__block">
      <span class="mono ps__lime ps__eyebrow">[ {t.processLabel} ]</span>
      <h3>{t.processHeading}</h3>
      <div class="ps__wireframes">
        {[
          ['09-wireframe-01.webp', 392],
          ['10-wireframe-02.webp', 392],
          ['11-wireframe-03.webp', 393],
          ['12-wireframe-04.webp', 393],
        ].map(([file, h], i) => (
          <figure class="ps__wireframe">
            <span class="mono ps__wireframe-num">{String(i + 1).padStart(2, '0')}</span>
            <img src={img(file as string)} width="627" height={h} alt="" loading="lazy" />
          </figure>
        ))}
      </div>
      <p class="ps__caption">{t.processCaption}</p>
    </section>

    <section class="ps__block">
      <span class="mono ps__tomato ps__eyebrow">[ {t.insightLabel} ]</span>
      <h3>{t.insightHeading}</h3>
      <ol class="ps__insights">
        {t.insights.map(([h, p], i) => (
          <li><span class="mono">({String(i + 1).padStart(2, '0')})</span><strong>{h}</strong><p>{p}</p></li>
        ))}
      </ol>
    </section>

    <!-- Final design -->
    <section class="ps__block ps__final">
      <span class="mono ps__lime ps__eyebrow">[ {t.finalLabel} ]</span>
      <h3>{t.finalHeading}</h3>
      <div class="ps__final-shots">
        <figcaption class="mono">{t.finalDesktopLabel}</figcaption>
        <div class="ps__desktop-shots">
          <img class="ps__desktop-shot ps__desktop-shot--wide" src={img('26-desktop-hero.webp')} width="1200" height="742" alt="" loading="lazy" />
          <img class="ps__desktop-shot" src={img('30-desktop-services.webp')} width="1200" height="742" alt="" loading="lazy" />
